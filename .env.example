# Required in production. Vercel injects these after the Postgres and private
# Blob resources are connected to the project.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Optional: enables AI-assisted public-mention discovery through cited web search.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Optional: set to exa; defaults to parallel.
OPENROUTER_SEARCH_ENGINE=parallel

# Optional: enables Tea checks through a provider you are authorized to use.
# The endpoint receives a POST self-search payload and may return generic results
# or native Tea-shaped results under results, posts, boxxPosts, items, or data.items.
TEA_AUTHORIZED_ENDPOINT=
TEA_AUTHORIZED_TOKEN=

# Optional: enables reverse image search against public web pages.
# FaceCheck charges credits in production. Use testing mode while integrating.
FACE_CHECK_API_TOKEN=
FACE_CHECK_TESTING_MODE=true

# Required for the private /review analyst queue and review API.
ANALYST_REVIEW_TOKEN=

# Required to unlock reports with real payments. Create two recurring prices in
# Stripe — $9.99/week and $17.99/month — and paste their price IDs below.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
# Signing secret of the Stripe webhook endpoint pointing at POST /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
